<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Calculador de Negociação</title>
<style>
:root{
  --laranja:#ff7a00;
  --laranja2:#ff9a3d;
  --fundo:#080808;
  --card:#151515;
  --card2:#101010;
  --borda:#333;
  --texto:#f4f4f4;
  --muted:#a9a9a9;
  --verde:#22c55e;
  --vermelho:#ef4444;
}
*{box-sizing:border-box}
body{
  margin:0;background:linear-gradient(135deg,#070707,#15100b 55%,#080808);
  color:var(--texto);font-family:Arial,Helvetica,sans-serif;
}
.container{max-width:1250px;margin:auto;padding:24px}
h1{text-align:center;color:var(--laranja);font-size:34px;margin:8px 0}
.sub{text-align:center;color:var(--muted);margin-bottom:24px}
.card{
  background:rgba(21,21,21,.97);border:1px solid var(--borda);
  border-radius:16px;padding:22px;margin-bottom:18px;
  box-shadow:0 10px 30px rgba(0,0,0,.35)
}
h2{color:var(--laranja);font-size:20px;margin:0 0 16px;padding-bottom:10px;border-bottom:1px solid var(--borda)}
.grid{display:grid;grid-template-columns:repeat(3,1fr);gap:15px}
.grid2{display:grid;grid-template-columns:repeat(2,1fr);gap:15px}
.field{display:flex;flex-direction:column;gap:7px}
label{font-size:13px;font-weight:700;color:#ddd}
input,select,textarea{
  width:100%;padding:12px;border-radius:9px;border:1px solid #444;
  background:#090909;color:#fff;outline:none;font-size:14px
}
input:focus,select:focus,textarea:focus{border-color:var(--laranja);box-shadow:0 0 0 2px rgba(255,122,0,.12)}
input[readonly]{opacity:.8}
textarea{min-height:330px;resize:vertical;line-height:1.55}
.resultados{display:grid;grid-template-columns:repeat(4,1fr);gap:12px}
.kpi{
  background:#0d0d0d;border:1px solid #333;border-radius:12px;padding:15px
}
.kpi span{display:block;color:#999;font-size:12px;margin-bottom:7px}
.kpi strong{font-size:21px;color:var(--laranja2)}
.info{
  border-left:4px solid var(--laranja);background:rgba(255,122,0,.07);
  padding:13px;border-radius:7px;color:#ddd;line-height:1.5
}
.alert{
  border-left:4px solid var(--vermelho);background:rgba(239,68,68,.08);
  padding:13px;border-radius:7px;color:#fecaca;line-height:1.5;margin-top:12px
}
.success{
  border-left:4px solid var(--verde);background:rgba(34,197,94,.07);
  padding:13px;border-radius:7px;color:#bbf7d0;line-height:1.5;margin-top:12px
}
.rules{
  display:grid;grid-template-columns:repeat(2,1fr);gap:12px
}
.rule{
  background:#0d0d0d;border:1px solid #333;border-radius:10px;padding:14px
}
.rule b{color:var(--laranja2)}
.buttons{display:flex;gap:10px;flex-wrap:wrap}
button{
  border:0;border-radius:9px;padding:12px 17px;font-weight:700;
  cursor:pointer;transition:.2s
}
button:hover{transform:translateY(-1px);filter:brightness(1.08)}
.primary{background:var(--laranja);color:#000}
.secondary{background:#333;color:#fff;border:1px solid #555}
.green{background:var(--verde);color:#000}
.red{background:#b91c1c;color:#fff}
.scriptHead{display:flex;justify-content:space-between;align-items:center;gap:12px}
.editing{border:2px solid var(--laranja)!important;background:#111!important}
.hidden{display:none!important}
.badge{
  display:inline-block;background:#292929;border:1px solid #444;
  color:#ddd;padding:6px 9px;border-radius:20px;font-size:12px;margin:3px
}
@media(max-width:850px){
  .grid,.grid2,.rules{grid-template-columns:1fr}
  .resultados{grid-template-columns:repeat(2,1fr)}
  .scriptHead{flex-direction:column;align-items:stretch}
}
</style>
</head>
<body>
<div class="container">

<h1>🟠 CALCULADOR DE NEGOCIAÇÃO</h1>
<div class="sub">Cálculo automático de entrada, parcelas e geração do script de atendimento</div>



<div class="card">
  <h2>👤 Dados do Cliente</h2>
  <div class="grid">
    <div class="field"><label>Cliente</label><input id="cliente" placeholder="Nome do cliente"></div>
    <div class="field"><label>TELL</label><input id="tell" placeholder="Telefone do cliente"></div>
    <div class="field"><label>Valor total do débito (R$)</label><input id="debito" type="number" min="0" step="0.01" placeholder="0,00" oninput="calcular()"></div>
    <div class="field">
      <label>⚠️ O PLANO ESTÁ HABILITADO OU CANCELADO?</label>
      <select id="situacao" onchange="calcular(); atualizarAvisoPlano()">
        <option value="ativo">🟢 PLANO HABILITADO</option>
        <option value="cancelado">🔴 PLANO CANCELADO</option>
      </select>
    </div>
    <div class="field"><label>Data de vencimento da entrada</label><input id="vencimento" type="date" onchange="calcular()"></div>
    <div class="field"><label>Pagamento à vista?</label>
      <select id="avista" onchange="calcular()">
        <option value="nao">Não</option>
        <option value="sim">Sim</option>
      </select>
    </div>
  </div>
</div>

<div id="avisoPlano" class="info" style="font-size:15px;font-weight:700;margin-bottom:18px;">
  ⚠️ CONFIRME: O PLANO ESTÁ HABILITADO?
</div>

<div class="card">
  <h2>🧮 Resultado do Cálculo</h2>
  <div class="resultados">
    <div class="kpi"><span>Regra aplicada</span><strong id="regra">—</strong></div>
    <div class="kpi"><span>Entrada</span><strong id="entradaPct">—</strong></div>
    <div class="kpi"><span>Valor da entrada</span><strong id="entradaValor">R$ 0,00</strong></div>
    <div class="kpi"><span>Parcelas</span><strong id="parcelas">—</strong></div>
  </div>
  <br>
  <div class="resultados">
    <div class="kpi"><span>Saldo parcelado</span><strong id="saldo">R$ 0,00</strong></div>
    <div class="kpi"><span>Valor de cada parcela</span><strong id="valorParcela">R$ 0,00</strong></div>
    <div class="kpi"><span>Condição</span><strong id="condicao">—</strong></div>
    <div class="kpi"><span>Data da entrada</span><strong id="dataExibida">—</strong></div>
  </div>
  <div id="avisoCalculo" class="alert hidden"></div>
</div>

<div class="card">
  <h2>⚙️ Ajuste da Negociação</h2>
  <div class="grid">
    <div class="field"><label>Percentual de entrada</label><input id="pctManual" type="number" min="0" max="100" step="0.01" placeholder="Automático" oninput="calcular(true)"></div>
    <div class="field"><label>Quantidade de parcelas</label><input id="parcelasManual" type="number" min="1" max="7" placeholder="Automático" oninput="calcular(true)"></div>
    <div class="field"><label>Regra especial acima de R$ 1.000,00</label>
      <select id="especial" onchange="calcular()">
        <option value="auto">Automático</option>
        <option value="igual2">2x parcelas iguais</option>
        <option value="igual3">3x parcelas iguais</option>
        <option value="igual4">4x parcelas iguais</option>
        <option value="igual5">5x parcelas iguais</option>
        <option value="igual6">6x parcelas iguais</option>
        <option value="igual7">7x parcelas iguais</option>
      </select>
    </div>
  </div>
  <div class="info">
    Os campos manuais permitem ajustar o cálculo para conferência. Se deixados vazios,
    o sistema usa automaticamente a regra da faixa.
  </div>
</div>

<div class="card">
  <h2>⚙️ Ações dos Scripts</h2>
  <div class="buttons">
    <button class="primary" onclick="gerar()">⚙️ GERAR / ATUALIZAR</button>
    <button class="secondary" onclick="editarScript()">✏️ EDITAR SCRIPT DO CLIENTE</button>
    <button class="secondary" onclick="editarRegistro()">✏️ EDITAR REGISTRO</button>
    <button class="red" onclick="limpar()">🗑️ LIMPAR</button>
  </div>
  <div class="info">
    Gere ou atualize os scripts após preencher os dados. Use os botões de edição
    para alterar manualmente o texto antes de copiar.
  </div>
</div>
<div class="card">
  <h2>📝 Script para encaminhar ao cliente</h2>
  <div class="scriptHead">
    <div class="badge">Gerado automaticamente</div>
    <div class="buttons">
      <button class="secondary" id="editarBtn" onclick="editarScript()">✏️ EDITAR</button>
      <button class="primary" onclick="copiarScript()">📋 COPIAR</button>
    </div>
  </div>
  <br>
  <textarea id="script" readonly></textarea>
</div>

<div class="card">
  <h2>🤝 Retorno do Cliente</h2>
  <div class="grid2">
    <div class="field">
      <label>Resultado da negociação</label>
      <select id="resultadoNegociacao" onchange="mostrarDesistencia()">
        <option value="aceitou">CLIENTE ACEITOU A NEGOCIAÇÃO</option>
        <option value="desistiu">CLIENTE DESISTIU DA NEGOCIAÇÃO</option>
      </select>
    </div>
    <div class="field hidden" id="campoDesistencia">
      <label>Descreva o motivo da desistência</label>
      <input id="motivoDesistencia" type="text" placeholder="Descreva o motivo informado pelo cliente">
    </div>
  </div>
  <div class="info">
    Se o cliente desistir, informe o motivo para que ele seja incluído automaticamente no registro do atendimento.
  </div>
</div>

<div class="card">
  <h2>🧾 Script para registro no atendimento</h2>
  <div class="scriptHead">
    <div class="badge">Registro interno</div>
    <div class="buttons">
      <button class="secondary" id="editarRegistroBtn" onclick="editarRegistro()">✏️ EDITAR</button>
      <button class="primary" onclick="copiarRegistro()">📋 COPIAR</button>
    </div>
  </div>
  <br>
  <textarea id="registro" readonly></textarea>
</div>



<div class="card">
  <h2>📚 Regras de Negociação</h2>
  <div class="info">
    O sistema aplica automaticamente a faixa de negociação conforme o valor do débito.
    Para plano cancelado, utiliza a regra específica de cancelamento. Em valores acima de
    R$ 1.000,00 com plano cancelado, também é disponibilizada a opção de parcelas iguais.
  </div>
  <br>
  <div class="rules">
    <div class="rule"><b>R$ 100,00 a R$ 300,00</b><br>Entrada: 60% · 2 parcelas</div>
    <div class="rule"><b>R$ 300,01 a R$ 500,00</b><br>Entrada: 50% · 3 parcelas</div>
    <div class="rule"><b>R$ 500,01 a R$ 700,00</b><br>Entrada: 40% · 4 parcelas</div>
    <div class="rule"><b>Acima de R$ 700,00</b><br>Entrada: 30% · 5 parcelas</div>
  </div>
  <div class="alert">
    <b>Plano cancelado:</b> a regra de entrada é diferente. O sistema troca automaticamente
    para 50%, 40%, 30% ou 20%, conforme a faixa do débito.
  </div>
</div>

</div>

<script>
const brl = n => new Intl.NumberFormat('pt-BR',{style:'currency',currency:'BRL'}).format(Number(n)||0);
const num = id => parseFloat(document.getElementById(id).value) || 0;
const val = id => document.getElementById(id).value.trim();

function dataBR(v){
  if(!v) return '—';
  const p=v.split('-');
  return p.length===3 ? `${p[2]}/${p[1]}/${p[0]}` : v;
}

function regraBase(valor, cancelado){
  if(valor < 100){
    return {pct:0, parcelas:0, nome:'Abaixo de R$ 100,00'};
  }
  if(valor <= 300) return cancelado ? {pct:50,parcelas:2,nome:'Cancelado · R$ 100,00 a R$ 300,00'} : {pct:60,parcelas:2,nome:'R$ 100,00 a R$ 300,00'};
  if(valor <= 500) return cancelado ? {pct:40,parcelas:3,nome:'Cancelado · R$ 300,01 a R$ 500,00'} : {pct:50,parcelas:3,nome:'R$ 300,01 a R$ 500,00'};
  if(valor <= 700) return cancelado ? {pct:30,parcelas:4,nome:'Cancelado · R$ 500,01 a R$ 700,00'} : {pct:40,parcelas:4,nome:'R$ 500,01 a R$ 700,00'};
  return cancelado ? {pct:20,parcelas:5,nome:'Cancelado · acima de R$ 700,00'} : {pct:30,parcelas:5,nome:'Acima de R$ 700,00'};
}

function atualizarAvisoPlano(){
  const aviso=document.getElementById('avisoPlano');
  const situacao=val('situacao');

  if(situacao==='cancelado'){
    aviso.innerHTML='🔴 <b>PLANO CANCELADO:</b> confirme que o plano está cancelado antes de prosseguir. A regra especial de cancelado será aplicada automaticamente.';
    aviso.className='alert';
  }else{
    aviso.innerHTML='🟢 <b>PLANO HABILITADO:</b> confirme que o plano está habilitado antes de prosseguir. A regra normal de negociação será aplicada.';
    aviso.className='success';
  }
}

function calcular(modoManual=false){
  const debito=num('debito');
  const cancelado=val('situacao')==='cancelado';
  const avista=val('avista')==='sim';
  let r=regraBase(debito,cancelado);

  const especial=val('especial');
  if(debito>1000 && cancelado && especial!=='auto'){
    const n=parseInt(especial.replace('igual',''));
    r={pct:0,parcelas:n,nome:`Cancelado > R$ 1.000,00 · ${n}x parcelas iguais`};
  }

  const pctManual=document.getElementById('pctManual').value;
  const parcelasManual=document.getElementById('parcelasManual').value;
  let pct = pctManual!=='' ? Math.max(0,Math.min(100,parseFloat(pctManual))) : r.pct;
  let parcelas = parcelasManual!=='' ? Math.max(1,parseInt(parcelasManual)) : r.parcelas;

  if(avista){
    pct=100; parcelas=0; r={...r,nome:'Pagamento à vista'};
  }

  let entrada=debito*(pct/100);
  let saldo=debito-entrada;
  let parcela=parcelas>0 ? saldo/parcelas : 0;

  // Regra de parcelas iguais para valores > 1000 cancelados:
  // divide o valor total pela quantidade escolhida.
  if(debito>1000 && cancelado && especial!=='auto'){
    entrada=0;
    saldo=debito;
    parcela=parcelas>0 ? debito/parcelas : debito;
    pct=0;
  }

  document.getElementById('regra').textContent=r.nome;
  document.getElementById('entradaPct').textContent=pct.toFixed(2).replace('.',',')+'%';
  document.getElementById('entradaValor').textContent=brl(entrada);
  document.getElementById('parcelas').textContent=parcelas ? parcelas+'x' : 'À vista';
  document.getElementById('saldo').textContent=brl(saldo);
  document.getElementById('valorParcela').textContent=parcelas ? brl(parcela) : '—';
  document.getElementById('condicao').textContent=avista ? 'À vista' : (parcelas ? 'Boleto bancário' : '—');
  document.getElementById('dataExibida').textContent=dataBR(val('vencimento'));

  const aviso=document.getElementById('avisoCalculo');
  if(debito>0 && debito<100){
    aviso.textContent='O valor informado está abaixo de R$ 100,00; a tabela de regras disponível não define uma condição automática para essa faixa.';
    aviso.classList.remove('hidden');
  }else{
    aviso.classList.add('hidden');
  }
  return {debito,cancelado,avista,pct,parcelas,entrada,saldo,parcela,regra:r.nome};
}

function mostrarDesistencia(){
  const resultado=val('resultadoNegociacao');
  const campo=document.getElementById('campoDesistencia');
  if(resultado==='desistiu'){
    campo.classList.remove('hidden');
  }else{
    campo.classList.add('hidden');
    document.getElementById('motivoDesistencia').value='';
  }
}

function gerar(){
  const c=calcular();
  const cliente=val('cliente')||'xxxxxxxxxxxxxx';
  const tell=val('tell')||'XXXXXXXXXXXXXXXXXXXX';
  const data=dataBR(val('vencimento'))==='—' ? 'XX/XX/XXXX' : dataBR(val('vencimento'));
  const resultado=val('resultadoNegociacao');
  const motivo=val('motivoDesistencia')||'Motivo não informado pelo cliente';

  let texto='';
  if(c.avista){
    texto=`Verifiquei que o valor total do seu débito é de ${brl(c.debito)}. Podemos realizar o pagamento à vista no valor de ${brl(c.debito)}. Você aceita essa negociação?`;
  }else if(c.debito>1000 && c.cancelado && c.pct===0){
    texto=`Verifiquei que o valor total do seu débito é de ${brl(c.debito)}. Para esta situação, podemos realizar a negociação em ${c.parcelas} parcelas iguais de ${brl(c.parcela)}. Você aceita essa negociação?`;
  }else{
    texto=`Verifiquei que o valor total do seu débito é de ${brl(c.debito)}. O que podemos estar fazendo é você realizar o pagamento de uma entrada de ${c.pct.toFixed(2).replace('.',',')}% com vencimento para o dia ${data} no valor de ${brl(c.entrada)} mais ${c.parcelas} parcelas de ${brl(c.parcela)} para os meses seguintes. Você aceita essa negociação?`;
  }

  document.getElementById('script').value=texto;

  document.getElementById('registro').value=
`CLIENTE: ${cliente}
TELL: ${tell}

VALOR TOTAL DO DÉBITO: ${brl(c.debito)}
SITUAÇÃO DO PLANO: ${c.cancelado?'CANCELADO':'ATIVO / INADIMPLENTE'}
REGRA APLICADA: ${c.regra}
ENTRADA: ${c.pct.toFixed(2).replace('.',',')}% — ${brl(c.entrada)}
VENCIMENTO DA ENTRADA: ${data}
QUANTIDADE DE PARCELAS: ${c.parcelas || 'À VISTA'}
VALOR DE CADA PARCELA: ${c.parcelas?brl(c.parcela):'—'}
CONDIÇÃO: ${c.avista?'PAGAMENTO À VISTA':'BOLETO BANCÁRIO'}

NEGOCIAÇÃO APRESENTADA AO CLIENTE.

RESULTADO: ${resultado==='aceitou' ? 'CLIENTE ACEITOU A NEGOCIAÇÃO' : 'CLIENTE DESISTIU DA NEGOCIAÇÃO'}
${resultado==='desistiu' ? 'MOTIVO DA DESISTÊNCIA: '+motivo : ''}`;

  bloquear('script','editarBtn');
  bloquear('registro','editarRegistroBtn');
}

function bloquear(campoId,btnId){
  const campo=document.getElementById(campoId), btn=document.getElementById(btnId);
  campo.setAttribute('readonly','true');
  campo.classList.remove('editing');
  btn.textContent='✏️ EDITAR';
  btn.className='secondary';
}

function alternarEdicao(campoId,btnId){
  const campo=document.getElementById(campoId), btn=document.getElementById(btnId);
  if(campo.hasAttribute('readonly')){
    campo.removeAttribute('readonly');
    campo.classList.add('editing');
    btn.textContent='💾 SALVAR EDIÇÃO';
    btn.className='green';
    campo.focus();
  }else{
    bloquear(campoId,btnId);
  }
}

function editarScript(){alternarEdicao('script','editarBtn')}
function editarRegistro(){alternarEdicao('registro','editarRegistroBtn')}

async function copiar(id){
  const campo=document.getElementById(id);
  if(!campo.value.trim()){alert('Gere o script primeiro.');return}
  try{
    await navigator.clipboard.writeText(campo.value);
    alert('Copiado com sucesso!');
  }catch(e){
    campo.removeAttribute('readonly');campo.select();document.execCommand('copy');campo.setAttribute('readonly','true');
    alert('Copiado!');
  }
}
function copiarScript(){copiar('script')}
function copiarRegistro(){copiar('registro')}

function limpar(){
  ['cliente','tell','debito','vencimento','pctManual','parcelasManual','script','registro'].forEach(id=>{
    document.getElementById(id).value='';
  });
  document.getElementById('situacao').value='ativo';
  document.getElementById('avista').value='nao';
  document.getElementById('especial').value='auto';
  document.getElementById('resultadoNegociacao').value='aceitou';
  document.getElementById('motivoDesistencia').value='';
  mostrarDesistencia();
  atualizarAvisoPlano();
  ['script','registro'].forEach((id,i)=>bloquear(id,i?'editarRegistroBtn':'editarBtn'));
  calcular();
}

['cliente','tell','debito','situacao','vencimento','avista','pctManual','parcelasManual','especial'].forEach(id=>{
  document.getElementById(id).addEventListener('input',()=>calcular());
  document.getElementById(id).addEventListener('change',()=>calcular());
});

calcular();
atualizarAvisoPlano();
</script>
</body>
</html>
